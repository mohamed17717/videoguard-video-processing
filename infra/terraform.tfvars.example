# Example variable values for terraform apply.
#
# COPY this file to terraform.tfvars and fill in real values. NEVER commit
# terraform.tfvars: the two credential variables are secrets, and the
# contract forbids secrets in tracked files (CONTRACT.md section 10).

env                   = "dev"
region                = "us-east-1"
account_id            = "" # leave empty; read from data.aws_caller_identity
bucket_name           = "" # leave empty; vg-media-<env>

# Railway webhook endpoint (exact route from the Go control plane).
webhook_host          = "vg-api-production.up.railway.app"
webhook_path          = "/internal/pipeline/webhook" # must match the Go route

# Playback DNS (cloudflare.tf).
pull_zone_hostname    = "media"
cloudflare_zone_id    = "REPLACE_WITH_CLOUDFLARE_ZONE_ID"

# Credentials - NEVER real values in tracked files.
bunny_api_key         = "REPLACE_WITH_BUNNY_ACCOUNT_API_KEY"
cloudflare_api_token  = "REPLACE_WITH_CLOUDFLARE_DNS_TOKEN"

# Railway control-plane IAM user name.
railway_iam_user_name = "vg-backend-railway"

# Worker fleet (PRICING.md: g6.xlarge / L4, min 0, max 3).
asg_min               = 0
asg_max               = 3
instance_type         = "g6.xlarge"
ami_id                = "" # set to the Packer AMI id before apply
generator_image       = "" # e.g. 111122223333.dkr.ecr.us-east-1.amazonaws.com/forensic-wm-generator:hevc-v1-<sha>
validator_image       = "" # e.g. 111122223333.dkr.ecr.us-east-1.amazonaws.com/vg-validator:pinned-<sha>

# Timings (CONTRACT.md sections 2, 4, 8).
presign_ttl_seconds       = 900
job_deadline_sec          = 3600
visibility_timeout_seconds = 900
heartbeat_sec             = 300

# Secrets Manager ARNs (secrets created outside Terraform; the worker reads
# the VALUES at run time, never Terraform).
webhook_secret_arn   = "arn:aws:secretsmanager:us-east-1:111122223333:secret:vg/webhook-AbCdEf"
axinom_secret_arn    = "arn:aws:secretsmanager:us-east-1:111122223333:secret:vg/axinom-AbCdEf"
watermark_secret_arn = "arn:aws:secretsmanager:us-east-1:111122223333:secret:vg/watermark-AbCdEf"
